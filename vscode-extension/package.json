{
  "name": "maengine",
  "displayName": "MAEngine - Mechanical Engineering IDE",
  "description": "Open-Source Mechanical Engineering IDE: CAD, conformal meshing, CalculiX FEA, and 3D simulation analysis.",
  "version": "0.1.0",
  "publisher": "maengine-team",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Linters"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^5.3.3"
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:maengine.modelTree",
    "onLanguage:calculix",
    "workspaceContains:**/simulation.yaml",
    "workspaceContains:**/maengine.yaml",
    "onCommand:maengine.runPipeline",
    "onCommand:maengine.openMarketplace",
    "onCommand:maengine.viewResults"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "maengine-explorer",
          "title": "MAEngine",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "maengine-explorer": [
        {
          "id": "maengine.modelTree",
          "name": "Simulation Model Tree"
        },
        {
          "id": "maengine.residualsView",
          "name": "Solver Convergence Telemetry"
        }
      ]
    },
    "commands": [
      {
        "command": "maengine.runPipeline",
        "title": "MAEngine: Run Full Simulation Pipeline",
        "category": "MAEngine"
      },
      {
        "command": "maengine.generateMesh",
        "title": "MAEngine: Mesh CAD Model (Gmsh)",
        "category": "MAEngine"
      },
      {
        "command": "maengine.solveCalculix",
        "title": "MAEngine: Solve with CalculiX",
        "category": "MAEngine"
      },
      {
        "command": "maengine.viewResults",
        "title": "MAEngine: Open 3D Results Viewport",
        "category": "MAEngine"
      },
      {
        "command": "maengine.openMarketplace",
        "title": "MAEngine: Open Simulation Marketplace",
        "category": "MAEngine"
      }
    ],
    "languages": [
      {
        "id": "calculix",
        "aliases": [
          "CalculiX Input Deck",
          "Abaqus Input",
          "inp"
        ],
        "extensions": [
          ".inp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "calculix",
        "scopeName": "source.calculix",
        "path": "./syntaxes/calculix.tmLanguage.json"
      }
    ]
  }
}
