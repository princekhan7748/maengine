*HEADING
Model: {{ project.name }}
Generated by MechaStudio - Open-Source CAE Engine
Units: {{ project.units.value }}
**
** =============================================================
** GEOMETRY & MESH
** =============================================================
*INCLUDE, INPUT={{ mesh_file }}
**
** =============================================================
** MATERIAL DEFINITIONS
** =============================================================
{% for mat in project.materials %}
*MATERIAL, NAME={{ mat.name }}
*ELASTIC
{{ mat.elastic.youngs_modulus }}, {{ mat.elastic.poissons_ratio }}
{% if mat.density is not none %}
*DENSITY
{{ mat.density }}
{% endif %}
{% if mat.plastic %}
*PLASTIC
{% for pt in mat.plastic %}
{{ pt.yield_stress }}, {{ pt.plastic_strain }}
{% endfor %}
{% endif %}
{% endfor %}
**
** =============================================================
** SECTION ASSIGNMENTS
** =============================================================
{% for sec in sections %}
*SOLID SECTION, ELSET={{ sec.elset }}, MATERIAL={{ sec.material }}
{% endfor %}
**
** =============================================================
** ANALYSIS STEPS
** =============================================================
{% for step in project.steps %}
*STEP{% if step.nlgeom %}, NLGEOM{% endif %}

{% if step.type.value in ["static_linear", "static_nonlinear"] %}
*STATIC
{{ step.time_increment_initial }}, {{ step.time_period }}
{% elif step.type.value == "modal_frequency" %}
*FREQUENCY
{{ step.num_modes or 10 }}
{% endif %}
**
** --- BOUNDARY CONDITIONS ---
**
*BOUNDARY
{% for bc in step.boundary_conditions %}
{% if bc.type.value == "fixed" %}
{{ bc.target_set }}, 1, 3, 0.0
{% elif bc.type.value == "displacement" %}
{% if bc.u1 is not none %}{{ bc.target_set }}, 1, 1, {{ bc.u1 }}{% endif %}
{% if bc.u2 is not none %}{{ bc.target_set }}, 2, 2, {{ bc.u2 }}{% endif %}
{% if bc.u3 is not none %}{{ bc.target_set }}, 3, 3, {{ bc.u3 }}{% endif %}
{% endif %}
{% endfor %}
**
** --- APPLIED LOADS ---
**
{% for load in step.loads %}
{% if load.type.value == "pressure" %}
*DLOAD
{{ load.target_set }}, P, {{ load.magnitude }}
{% elif load.type.value == "force" %}
*CLOAD
{{ load.target_set }}, 1, {{ load.direction[0] * load.magnitude if load.direction else 0.0 }}
{{ load.target_set }}, 2, {{ load.direction[1] * load.magnitude if load.direction else 0.0 }}
{{ load.target_set }}, 3, {{ load.direction[2] * load.magnitude if load.direction else 0.0 }}
{% elif load.type.value == "gravity" %}
*DLOAD
EALL, GRAV, {{ load.magnitude }}, {{ load.direction[0] }}, {{ load.direction[1] }}, {{ load.direction[2] }}
{% endif %}
{% endfor %}
**
** --- OUTPUT REQUESTS (Displacement, Stresses, Reaction Forces) ---
**
*NODE FILE
U, RF
*EL FILE
S, E
*NODE PRINT, NSET=NALL
U
*EL PRINT, ELSET=EALL
S
*END STEP
{% endfor %}
